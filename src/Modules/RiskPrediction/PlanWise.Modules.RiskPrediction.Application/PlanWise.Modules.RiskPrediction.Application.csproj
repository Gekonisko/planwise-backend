<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="MediatR" Version="14.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The model internals (scorer, velocity estimator, sprint forecaster) are the parts most worth
         testing and the parts with no reason to be public. -->
    <InternalsVisibleTo Include="PlanWise.Modules.RiskPrediction.Application.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fitted coefficients, compiled in rather than loaded from disk: the model is a few dozen
         floats, and embedding it means a deployed build can never disagree with the code that
         reads it. Regenerated by research/sprint-slip-model/export_model.py. -->
    <EmbeddedResource Include="Risks\Model\sprint-slip-model.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Common\PlanWise.Common.Application\PlanWise.Common.Application.csproj" />
    <ProjectReference Include="..\PlanWise.Modules.RiskPrediction.Domain\PlanWise.Modules.RiskPrediction.Domain.csproj" />
  </ItemGroup>

</Project>
